{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moellere/wirestudio/schema/design.schema.json",
  "title": "wirestudio design.json",
  "type": "object",
  "required": ["schema_version", "id", "name", "board", "power"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1", "0.2", "0.3", "1.0"], "description": "1.0 is current; older versions are accepted and migrated on load (0.1 and 0.3: the lorawan.gps / dht22 / oled blocks become components; 0.2: fields nothing read are dropped)." },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "description": { "type": "string", "description": "Shown in the design pane and in the saved-design and example lists." },

    "board": {
      "type": "object",
      "required": ["library_id", "mcu"],
      "additionalProperties": false,
      "properties": {
        "library_id": { "type": "string" },
        "mcu": { "type": "string" },
        "framework": { "type": "string", "default": "arduino" },
        "flash_size_mb": { "enum": [4, 8, 16, 32] },
        "revision": { "type": "string", "description": "One of the board file's `revisions:`, for boards whose wiring differs between hardware revisions (the Heltec V4's PA control pin). Unset uses the board file's own wiring; validate warns when the board has revisions and the design names none." }
      }
    },

    "power": {
      "type": "object",
      "description": "The supply the design was made for. `budget_ma` is the only field the pin solver and generators read (the current-budget warning and the ASCII summary); `supply`, `rail_voltage_v` and `regulator` are the design's record and appear in no artifact.",
      "required": ["supply", "rail_voltage_v"],
      "additionalProperties": false,
      "properties": {
        "supply": { "type": "string" },
        "rail_voltage_v": { "type": "number" },
        "regulator": { "type": "string" },
        "budget_ma": { "type": "integer", "minimum": 1 }
      }
    },

    "requirements": {
      "type": "array",
      "description": "The intent the design was built to meet, edited in the inspector and by the agent. No generator reads it.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["capability", "environment", "constraint"] },
          "text": { "type": "string" }
        }
      }
    },

    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "library_id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "library_id": { "type": "string" },
          "label": { "type": "string" },
          "role": { "type": "string", "description": "Free text shown in the inspector; no generator reads it." },
          "params": { "type": "object", "description": "Values for the library component's params_schema, read by its ESPHome template and footprint." },
          "locked_pins": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Pin role -> board pin the solver must keep." },
          "module": {
            "type": "object",
            "description": "Set when the component was inserted as part of a composite module; the BOM lists the module once per instance instead of this part.",
            "required": ["module_id", "instance"],
            "additionalProperties": false,
            "properties": {
              "module_id": { "type": "string" },
              "instance": { "type": "string" }
            }
          }
        }
      }
    },

    "buses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["i2c", "spi", "uart", "1wire", "i2s"] },
          "frequency_hz": { "type": "integer" },
          "baud_rate": { "type": "integer" },
          "sda": { "type": "string" },
          "scl": { "type": "string" },
          "miso": { "type": "string" },
          "mosi": { "type": "string" },
          "clk": { "type": "string" },
          "cs": { "type": "string" },
          "rx": { "type": "string" },
          "tx": { "type": "string" },
          "lrclk": { "type": "string" },
          "bclk": { "type": "string" },
          "pin": { "type": "string", "description": "1-wire data pin." },
          "parity": { "type": "string", "enum": ["NONE", "EVEN", "ODD"], "description": "UART parity; omitted means NONE." }
        }
      }
    },

    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "pin_role", "target"],
        "additionalProperties": false,
        "properties": {
          "component_id": { "type": "string" },
          "pin_role": { "type": "string" },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "rail"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "rail" },
                  "rail": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "pin"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "gpio" },
                  "pin": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "bus_id"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "bus" },
                  "bus_id": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "expander_id", "number"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "expander_pin" },
                  "expander_id": { "type": "string" },
                  "number": { "type": "integer", "minimum": 0 },
                  "mode": { "type": "string", "enum": ["INPUT", "INPUT_PULLUP", "INPUT_PULLDOWN", "OUTPUT", "OUTPUT_OPEN_DRAIN"] },
                  "inverted": { "type": "boolean" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "component_id"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "component" },
                  "component_id": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "net" },
                  "component_id": { "type": "string" },
                  "net": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },

    "part_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Drawer substitutions for subcircuit parts: '<component id>.<part id>' -> MPN. Changes the printed value only; symbol and footprint stay."
    },

    "passives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "value", "between"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["resistor", "capacitor", "inductor", "diode", "transistor"] },
          "value": { "type": "string" },
          "between": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "purpose": { "type": "string" }
        }
      }
    },

    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "trigger": {
            "type": "object",
            "required": ["component_id", "event"],
            "additionalProperties": false,
            "properties": {
              "component_id": { "type": "string" },
              "event": { "type": "string" },
              "channel": {
                "type": "string",
                "description": "Sub-block on multi-channel components (e.g. \"temperature\" on a bme280); omit for single-output."
              },
              "above": {
                "type": "number",
                "description": "Lower bound for an on_value_range trigger; value must rise above this to fire. Set only when event is on_value_range."
              },
              "below": {
                "type": "number",
                "description": "Upper bound for an on_value_range trigger; value must fall below this to fire. Set only when event is on_value_range."
              }
            }
          },
          "conditions": {
            "type": "array",
            "description": "Predicates that gate the actions; the trigger must fire AND every condition must hold. Lowered to ESPHome's `if: { condition: ..., then: [...] }`.",
            "items": {
              "type": "object",
              "required": ["component_id", "predicate"],
              "additionalProperties": false,
              "properties": {
                "component_id": { "type": "string" },
                "predicate": { "type": "string" }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["component_id", "action"],
              "additionalProperties": false,
              "properties": {
                "component_id": { "type": "string" },
                "action": { "type": "string" },
                "args": { "type": "object" },
                "transform": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "description": "Action arg name -> C++ expression in terms of x (the trigger's value); lowered to !lambda \"return <expr>;\"."
                }
              }
            }
          }
        }
      }
    },

    "warnings": {
      "type": "array",
      "description": "What the last validate pass found. Permissive mode records violations here and generation proceeds; strict mode blocks on warn and error entries.",
      "items": {
        "type": "object",
        "required": ["level", "code", "text"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "string", "enum": ["info", "warn", "error"] },
          "code": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },

    "esphome_extras": { "type": "object", "description": "Raw ESPHome sections merged into the rendered config after the generated ones: header-level overrides and anything the library does not model." },

    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_name": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Labels shown in the inspector; not passed to fleet-for-esphome or ChirpStack." },
        "secrets_ref": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue", "slug", "author", "license"],
      "description": "The community-catalogue design this one was imported from, kept for attribution. No generator reads it.",
      "properties": {
        "catalogue": { "type": "string", "description": "GitHub owner/repo of the catalogue" },
        "slug": { "type": "string" },
        "author": { "type": "string", "description": "GitHub handle of the design's author" },
        "license": { "type": "string" }
      }
    },

    "target": { "type": "string", "enum": ["esphome", "lorawan"], "default": "esphome", "description": "What generate produces: ESPHome YAML or standalone LoRaWAN firmware. The Tasmota template is an export of an esphome design (POST /tasmota/template), not a target value." },

    "strict": { "type": "boolean", "default": false, "description": "When true, warn/error compatibility entries and design warnings block generation instead of surfacing permissively." },

    "lorawan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": { "type": "string", "enum": ["US915", "EU868", "AU915", "AS923"], "default": "US915" },
        "sub_band": { "type": "integer", "default": 2 },
        "join_eui": { "type": "string", "description": "MSB hex; both paths default to the zero EUI. The DevEUI and AppKey are not design fields: the device or the provision request supplies the one, ChirpStack mints the other." },
        "payload": {
          "type": "array",
          "description": "Ordered uplink field list for the ESPHome external-component target path (`lorawan-for-esphome`). Each entry packs a sensor's current value into the uplink; the ChirpStack decoder is generated from the same list so device and server stay in lockstep. Unused by the standalone Arduino path.",
          "items": {
            "type": "object",
            "required": ["sensor"],
            "additionalProperties": false,
            "properties": {
              "sensor": { "type": "string", "description": "design-level component_id whose value goes into this slot" }
            }
          }
        }
      }
    }
  }
}
