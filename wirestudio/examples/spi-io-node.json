{
  "schema_version": "0.1",
  "id": "spi-io-node",
  "name": "SPI IO node (MCP23S17 + MCP3008)",
  "description": "ESP32-DevKitC with an MCP23S17 16-bit SPI GPIO expander carrying two door contacts and a siren output, and an MCP3008 8-channel 10-bit SPI ADC reading a tank-level pot and a light sensor. Both chips share the VSPI bus with their own CS lines.",
  "created_at": "2026-10-03T00:00:00Z",
  "updated_at": "2026-10-03T00:00:00Z",

  "board": {
    "library_id": "esp32-devkitc-v4",
    "mcu": "esp32",
    "framework": "arduino"
  },

  "power": {
    "supply": "usb-5v",
    "rail_voltage_v": 5.0,
    "regulator": "onboard-ams1117",
    "budget_ma": 500
  },

  "requirements": [
    { "id": "r1", "kind": "capability", "text": "two door contacts and a siren on an SPI GPIO expander" },
    { "id": "r2", "kind": "capability", "text": "two analog readings through an external 8-channel SPI ADC" },
    { "id": "r3", "kind": "constraint", "text": "both chips share one SPI bus with separate chip selects" }
  ],

  "components": [
    {
      "id": "io_hub",
      "library_id": "mcp23s17",
      "label": "SPI IO expander",
      "role": "io_expander",
      "params": { "deviceaddress": 0 }
    },
    {
      "id": "front_door",
      "library_id": "gpio_input",
      "label": "Front Door",
      "params": { "device_class": "door" }
    },
    {
      "id": "back_door",
      "library_id": "gpio_input",
      "label": "Back Door",
      "params": { "device_class": "door" }
    },
    {
      "id": "siren",
      "library_id": "gpio_output",
      "label": "Siren"
    },
    {
      "id": "adc_hub",
      "library_id": "mcp3008",
      "label": "SPI ADC"
    },
    {
      "id": "tank_level",
      "library_id": "mcp3008_channel",
      "label": "Tank Level",
      "params": { "number": 0, "reference_voltage": "3.3V", "update_interval": "30s" }
    },
    {
      "id": "light",
      "library_id": "mcp3008_channel",
      "label": "Ambient Light",
      "params": { "number": 7, "reference_voltage": "3.3V", "update_interval": "10s" }
    }
  ],

  "buses": [
    { "id": "spi_bus", "type": "spi", "clk": "GPIO18", "miso": "GPIO19", "mosi": "GPIO23" }
  ],

  "connections": [
    { "component_id": "io_hub", "pin_role": "VCC",   "target": { "kind": "rail", "rail": "3V3" } },
    { "component_id": "io_hub", "pin_role": "GND",   "target": { "kind": "rail", "rail": "GND" } },
    { "component_id": "io_hub", "pin_role": "SCK",   "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "io_hub", "pin_role": "MOSI",  "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "io_hub", "pin_role": "MISO",  "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "io_hub", "pin_role": "CS",    "target": { "kind": "gpio", "pin": "GPIO5" } },
    { "component_id": "io_hub", "pin_role": "RESET", "target": { "kind": "rail", "rail": "3V3" } },

    { "component_id": "front_door", "pin_role": "IN",  "target": { "kind": "expander_pin", "expander_id": "io_hub", "number": 0, "mode": "INPUT_PULLUP", "inverted": true } },
    { "component_id": "back_door",  "pin_role": "IN",  "target": { "kind": "expander_pin", "expander_id": "io_hub", "number": 1, "mode": "INPUT_PULLUP", "inverted": true } },
    { "component_id": "siren",      "pin_role": "OUT", "target": { "kind": "expander_pin", "expander_id": "io_hub", "number": 8, "mode": "OUTPUT" } },

    { "component_id": "adc_hub", "pin_role": "VCC",  "target": { "kind": "rail", "rail": "3V3" } },
    { "component_id": "adc_hub", "pin_role": "VREF", "target": { "kind": "rail", "rail": "3V3" } },
    { "component_id": "adc_hub", "pin_role": "GND",  "target": { "kind": "rail", "rail": "GND" } },
    { "component_id": "adc_hub", "pin_role": "CLK",  "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "adc_hub", "pin_role": "MOSI", "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "adc_hub", "pin_role": "MISO", "target": { "kind": "bus",  "bus_id": "spi_bus" } },
    { "component_id": "adc_hub", "pin_role": "CS",   "target": { "kind": "gpio", "pin": "GPIO17" } },

    { "component_id": "tank_level", "pin_role": "HUB", "target": { "kind": "component", "component_id": "adc_hub" } },
    { "component_id": "light",      "pin_role": "HUB", "target": { "kind": "component", "component_id": "adc_hub" } }
  ],

  "passives": [
    { "id": "c1", "kind": "capacitor", "value": "100nF", "between": ["io_hub.VCC", "GND"],   "purpose": "decoupling io_hub" },
    { "id": "c2", "kind": "capacitor", "value": "100nF", "between": ["adc_hub.VCC", "GND"],  "purpose": "decoupling adc_hub" },
    { "id": "c3", "kind": "capacitor", "value": "1uF",   "between": ["adc_hub.VREF", "GND"], "purpose": "reference decoupling" }
  ],

  "warnings": [],

  "esphome_extras": {
    "captive_portal": {},
    "logger": {}
  },

  "fleet": {
    "device_name": "spi-io-node",
    "tags": ["indoor", "spi", "expander", "analog"],
    "secrets_ref": {
      "wifi_ssid": "!secret wifi_ssid",
      "wifi_password": "!secret wifi_password",
      "api_key": "!secret api_key"
    }
  }
}
