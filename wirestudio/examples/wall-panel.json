{
  "schema_version": "1.0",
  "id": "wall-panel",
  "name": "Wall control panel",
  "description": "A wall-mounted room panel on the YD-ESP32-23: an HC-SR501 PIR for presence, a DHT22 for temperature and humidity, and the 1.3-inch OLED + EC11 knob module with its two buttons for a menu. The enclosure is generated from the parts: the board lies face down so its headers take Dupont jumpers from the front, the OLED, knob, buttons and PIR dome come through the lid, the DHT22 sits at the bottom behind vent slots, and keyhole slots in the back hang it on two screws.",
  "board": {
    "library_id": "yd-esp32-23",
    "mcu": "esp32",
    "framework": "arduino"
  },
  "power": {
    "supply": "usb-5v",
    "rail_voltage_v": 5.0,
    "regulator": "onboard-ams1117",
    "budget_ma": 500
  },
  "requirements": [
    {
      "id": "r1",
      "kind": "capability",
      "text": "detect someone in the room"
    },
    {
      "id": "r2",
      "kind": "capability",
      "text": "report room temperature and humidity"
    },
    {
      "id": "r3",
      "kind": "capability",
      "text": "show a menu on the OLED, driven by the knob and two buttons"
    },
    {
      "id": "r4",
      "kind": "constraint",
      "text": "hangs on a wall in a printed enclosure"
    }
  ],
  "components": [
    {
      "id": "pir",
      "library_id": "hc-sr501",
      "label": "Room PIR",
      "params": {}
    },
    {
      "id": "climate",
      "library_id": "dht",
      "label": "Room climate",
      "params": {
        "model": "DHT22"
      }
    },
    {
      "id": "disp",
      "library_id": "ssd1306",
      "label": "Panel OLED",
      "params": {
        "model": "SH1106 128x64",
        "address": "0x3C"
      },
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "knob",
      "library_id": "rotary_encoder",
      "label": "Menu knob",
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "knobbtn",
      "library_id": "gpio_input",
      "label": "Knob press",
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "btn1",
      "library_id": "gpio_input",
      "label": "Button A",
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "btn2",
      "library_id": "gpio_input",
      "label": "Button B",
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    }
  ],
  "buses": [
    {
      "id": "i2c0",
      "type": "i2c",
      "frequency_hz": 400000,
      "sda": "GPIO8",
      "scl": "GPIO9"
    }
  ],
  "connections": [
    {
      "component_id": "pir",
      "pin_role": "VCC",
      "target": {
        "kind": "rail",
        "rail": "5V"
      }
    },
    {
      "component_id": "pir",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    },
    {
      "component_id": "pir",
      "pin_role": "OUT",
      "target": {
        "kind": "gpio",
        "pin": "GPIO4"
      }
    },
    {
      "component_id": "climate",
      "pin_role": "VCC",
      "target": {
        "kind": "rail",
        "rail": "3V3"
      }
    },
    {
      "component_id": "climate",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    },
    {
      "component_id": "climate",
      "pin_role": "DATA",
      "target": {
        "kind": "gpio",
        "pin": "GPIO5"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "VCC",
      "target": {
        "kind": "rail",
        "rail": "3V3"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "SDA",
      "target": {
        "kind": "bus",
        "bus_id": "i2c0"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "SCL",
      "target": {
        "kind": "bus",
        "bus_id": "i2c0"
      }
    },
    {
      "component_id": "knob",
      "pin_role": "A",
      "target": {
        "kind": "gpio",
        "pin": "GPIO6"
      }
    },
    {
      "component_id": "knob",
      "pin_role": "B",
      "target": {
        "kind": "gpio",
        "pin": "GPIO7"
      }
    },
    {
      "component_id": "knobbtn",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO15"
      }
    },
    {
      "component_id": "btn1",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO16"
      }
    },
    {
      "component_id": "btn2",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO17"
      }
    }
  ],
  "passives": [
    {
      "id": "r3",
      "kind": "resistor",
      "value": "10k",
      "between": [
        "climate.DATA",
        "3V3"
      ],
      "purpose": "DHT data pull-up"
    },
    {
      "id": "c2",
      "kind": "capacitor",
      "value": "100nF",
      "between": [
        "climate.VCC",
        "GND"
      ],
      "purpose": "decoupling climate"
    },
    {
      "id": "c1",
      "kind": "capacitor",
      "value": "100nF",
      "between": [
        "disp.VCC",
        "GND"
      ],
      "purpose": "decoupling disp"
    },
    {
      "id": "r1",
      "kind": "resistor",
      "value": "4.7k",
      "between": [
        "i2c0.SDA",
        "3V3"
      ],
      "purpose": "I2C pull-up"
    },
    {
      "id": "r2",
      "kind": "resistor",
      "value": "4.7k",
      "between": [
        "i2c0.SCL",
        "3V3"
      ],
      "purpose": "I2C pull-up"
    }
  ],
  "warnings": [],
  "esphome_extras": {
    "captive_portal": {},
    "logger": {}
  },
  "fleet": {
    "device_name": "wall-panel",
    "tags": [
      "display",
      "input",
      "climate",
      "motion"
    ],
    "secrets_ref": {
      "wifi_ssid": "!secret wifi_ssid",
      "wifi_password": "!secret wifi_password",
      "api_key": "!secret api_key"
    }
  },
  "enclosure": {
    "board_orientation": "face_down",
    "mount": "wall"
  }
}
